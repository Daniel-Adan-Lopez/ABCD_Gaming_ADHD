#let's clean it up

#Filter to sessions of interest (02A to 04A only)
adhd_filtered <- ABCD_Med_Data_LassoVersion %>%
  filter(session_id %in% c("ses-00A", "ses-01A", "ses-02A", "ses-03A", "ses-04A", "ses-06A")) %>%
  select(participant_id, session_id, mh_p_ksads__adhd__pres_dx)

#Recode ADHD diagnosis for these sessions
adhd_filtered <- adhd_filtered %>%
  mutate(adhd_dx_clean = case_when(
    mh_p_ksads__adhd__pres_dx == 1 ~ 1,
    mh_p_ksads__adhd__pres_dx %in% c(0, 888) ~ 0,
    mh_p_ksads__adhd__pres_dx == 555 ~ NA_real_,
    TRUE ~ NA_real_
  ))

#join back
ABCD_Med_Data_LassoVersion <- ABCD_Med_Data_LassoVersion %>%
  left_join(adhd_filtered %>% select(participant_id, session_id, adhd_dx_clean),
            by = c("participant_id", "session_id"))


table(ABCD_Med_Data_LassoVersion$session_id, ABCD_Med_Data_LassoVersion$adhd_dx_clean , useNA = "always")
