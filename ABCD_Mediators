#first let's make sure it's in wide format
mediators <- c(
  "fc_y_fes__confl_mean",
  "fc_y_pm_mean",
  "fc_y_psb_mean",
  "fc_y_srpf__dis_mean",
  "fc_y_srpf__env_mean",
  "fc_y_srpf__involv_mean",
  "delinquent_peer_mean",
  "prosocial_peer_mean",
  "fc_y_crpbi__cg1_mean"
)

ABCD_wide_meds <- ABCD_Med_Data_LassoVersion %>%
  select(src_subject_id, session_id, all_of(mediators)) %>%
  pivot_wider(
    names_from = session_id,
    values_from = all_of(mediators),
    names_glue = "{.value}_{session_id}"
  )

#Flag missing if any required mediator wave was missing

ABCD$missing_mediator <- ifelse(
  is.na(ABCD$fc_y_fes__confl_mean_y2) | is.na(ABCD$fc_y_fes__confl_mean_y3) |
  is.na(ABCD$fc_y_pm_mean_y2) | is.na(ABCD$fc_y_pm_mean_y3) |
  is.na(ABCD$fc_y_psb_mean_y2) | is.na(ABCD$fc_y_psb_mean_y3) |
  is.na(ABCD$fc_y_srpf__dis_mean_y2) | is.na(ABCD$fc_y_srpf__dis_mean_y3) |
  is.na(ABCD$fc_y_srpf__env_mean_y2) | is.na(ABCD$fc_y_srpf__env_mean_y3) |
  is.na(ABCD$fc_y_srpf__involv_mean_y2) | is.na(ABCD$fc_y_srpf__involv_mean_y3) |
  is.na(ABCD$delinquent_peer_mean_y2) | is.na(ABCD$delinquent_peer_mean_y3) |
  is.na(ABCD$prosocial_peer_mean_y2) | is.na(ABCD$prosocial_peer_mean_y3) |
  is.na(ABCD$fc_y_crpbi__cg1_mean_y1) | is.na(ABCD$fc_y_crpbi__cg1_mean_y3),
  1, 0
)

