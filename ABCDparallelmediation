MODEL CONSTRAINT:
  NEW(indirect1 indirect2 indirect3 indirect4 
  indirect5 indirect6 indirect7 indirect8 indirect9);
  NEW(totalindirect direct totaleffect);
  NEW(prop_med1 prop_med2 prop_med3 prop_med4 
  prop_med5 prop_med6 prop_med7 prop_med8 prop_med9);

  indirect1 = a1 * b1;
  indirect2 = a2 * b2;
  indirect3 = a3 * b3;
  indirect4 = a4 * b4;
  indirect5 = a5 * b5;
  indirect6 = a6 * b6;
  indirect7 = a7 * b7;
  indirect8 = a8 * b8;
  indirect9 = a9 * b9;

 ! Total indirect effect
  totalindirect = indirect1 + indirect2 + indirect3 +
                  indirect4 + indirect5 + indirect6 +
                  indirect7 + indirect8 + indirect9;

! Direct effect
  direct = c;

  ! Total effect
  totaleffect = totalindirect + direct;

  prop_med1 = indirect1 / totaleffect;
  prop_med2 = indirect2 / totaleffect;
  prop_med3 = indirect3 / totaleffect;
  prop_med4 = indirect4 / totaleffect;
  prop_med5 = indirect5 / totaleffect;
  prop_med6 = indirect6 / totaleffect;
  prop_med7 = indirect7 / totaleffect;
  prop_med8 = indirect8 / totaleffect;
  prop_med9 = indirect9 / totaleffect;

MODEL INDIRECT:
  vgaq_4 IND adhd_dx_2;

OUTPUT:
  STDYX;
  CINTERVAL (BOOTSTRAP);
  SAMPSTAT;

PLOT:
