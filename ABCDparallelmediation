    srpfses_2 psbyss_2
    pbp_soc_2 pbp_rule_2 crpbi_2
    adhd_dx_2 (c);

  ! Mediator models
  pmqy_3 ON pmqy_2 sex visit_age_2 married_2 
  ncrimey_2 educ_2 income_2 site
